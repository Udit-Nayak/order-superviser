{
  "supervisor": {
    "name": "Delayed Shipment Scenario Supervisor",
    "base_instruction": "Supervise the order. Follow run-specific instructions exactly. Escalate shipment delays and close only after delivery.",
    "tools_enabled": [
      "send_customer_message",
      "create_internal_note",
      "escalate_issue",
      "mark_order_for_review",
      "schedule_next_wake_up",
      "close_workflow"
    ],
    "wake_aggressiveness": "high",
    "model_config": {
      "model": "gemini-3.6-flash",
      "temperature": 0.2
    }
  },
  "order_id": "ORDER-SCENARIO-DELAY-1",
  "default_wake_seconds": 30,
  "steps": [
    {
      "instruction": "If shipment is delayed, escalate immediately using escalate_issue.",
      "wait_after": 2
    },
    {
      "event": {
        "type": "shipment_delayed",
        "payload": {
          "delay_hours": 6
        }
      },
      "wait_after": 8
    },
    {
      "if": {
        "event_type_equals": "shipment_delayed"
      },
      "then": [
        {
          "instruction": "After escalation, keep monitoring until delivery.",
          "wait_after": 1
        }
      ]
    },
    {
      "event": {
        "type": "delivered",
        "payload": {
          "proof": "scenario-demo"
        }
      },
      "wait_after": 3
    }
  ]
}